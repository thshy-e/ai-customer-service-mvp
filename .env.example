# Shared deployment settings
CHATWOOT_VERSION=v4.16.2
CHATWOOT_PUBLIC_URL=http://localhost:3000
CHATWOOT_WEBSITE_TOKEN=
SECRET_KEY_BASE=replace-with-at-least-64-random-hex-characters
POSTGRES_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password

# AI service
APP_ENV=development
LOG_LEVEL=INFO
CHATWOOT_API_URL=http://rails:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=25
PUBLIC_ASSET_BASE_URL=http://localhost:8080

# AI 外贸销售助手（本地默认 SQLite；部署时可改为 PostgreSQL）
SALES_DATABASE_URL=sqlite+aiosqlite:///./data/sales.db
SALES_SESSION_SECRET=replace-with-a-sales-session-secret
SALES_ADMIN_EMAIL=admin@example.com
SALES_ADMIN_PASSWORD=change-me
SALES_USER_EMAIL=sales@example.com
SALES_USER_PASSWORD=change-me
SALES_MAX_UPLOAD_MB=100
SALES_VISION_ENABLED=true
SALES_OCR_ENABLED=true
SALES_OCR_CONCURRENCY=3
SALES_OCR_PAGE_TIMEOUT_SECONDS=35
SALES_VISION_MODEL=qwen3-vl-plus
SALES_OCR_MODEL=qwen3-vl-plus
SALES_TEXT_MODEL=qwen-plus
SALES_FAST_MODEL=qwen3.7-flash
SALES_EMBEDDING_MODEL=qwen3.7-text-embedding
